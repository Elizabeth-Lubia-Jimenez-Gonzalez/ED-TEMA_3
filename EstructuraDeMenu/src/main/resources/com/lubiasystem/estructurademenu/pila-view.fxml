<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" alignment="CENTER" xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="com.lubiasystem.estructurademenu.controller.PilaController" prefWidth="480" prefHeight="450"
      style="-fx-background-color: linear-gradient(to bottom right, #1e1e24, #121214); -fx-padding: 25px;">

    <!-- Título del Módulo -->
    <Label text="Módulo Pilas (5 Operaciones)"
           style="-fx-font-family: 'Segoe UI', Arial; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

    <!-- Campo de Entrada Estilizado -->
    <TextField fx:id="txtEntrada" promptText="Escribe un dato numérico o texto aquí"
               style="-fx-background-color: #2a2a32; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #808080; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-padding: 8px; -fx-font-family: 'Segoe UI';"/>

    <!-- Contenedor de Botones de Operación -->
    <HBox spacing="8" alignment="CENTER">
        <Button text="1. Push" onAction="#ejecutarPush"
                style="-fx-background-color: #0078ff; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 12px;"/>
        <Button text="2. Pop" onAction="#ejecutarPop"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 12px;"/>
        <Button text="3. Peek" onAction="#ejecutarPeek"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 12px;"/>
        <Button text="4. Mostrar" onAction="#ejecutarMostrar"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 12px;"/>
        <Button text="5. Limpiar" onAction="#ejecutarLimpiar"
                style="-fx-background-color: #a82020; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 12px;"/>
    </HBox>

    <!-- Área de Resultados Estilizada -->
    <TextArea fx:id="txtResultado" editable="false" prefHeight="160"
              style="-fx-control-inner-background: #18181b; -fx-text-fill: #00ff66; -fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 13px; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px;"/>

    <!-- Botón para regresar al menú principal -->
    <Button fx:id="btnRegresar" text="← Regresar al Menú" onAction="#ejecutarRegresar"
            style="-fx-background-color: transparent; -fx-text-fill: #8a8a93; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;"/>
</VBox>
