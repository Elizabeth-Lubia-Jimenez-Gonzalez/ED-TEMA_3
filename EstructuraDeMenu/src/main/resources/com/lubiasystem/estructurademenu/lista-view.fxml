<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" alignment="CENTER" xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="com.lubiasystem.estructurademenu.controller.ListaController" prefWidth="520" prefHeight="490"
      style="-fx-background-color: linear-gradient(to bottom right, #1e1e24, #121214); -fx-padding: 25px;">

    <!-- Título del Módulo -->
    <Label text="Módulo Listas (5 Operaciones)"
           style="-fx-font-family: 'Segoe UI', Arial; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

    <!-- Campos de Entrada Estilizados -->
    <TextField fx:id="txtEntrada" promptText="Dato (Texto/Valor)"
               style="-fx-background-color: #2a2a32; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #808080; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-padding: 8px; -fx-font-family: 'Segoe UI';"/>

    <TextField fx:id="txtIndice" promptText="Índice (Solo números para eliminar/modificar)"
               style="-fx-background-color: #2a2a32; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #808080; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-padding: 8px; -fx-font-family: 'Segoe UI';"/>

    <!-- Rejilla de Botones de Operación -->
    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <Button text="1. Agregar" onAction="#ejecutarAgregar" GridPane.columnIndex="0" GridPane.rowIndex="0"
                style="-fx-background-color: #0078ff; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 14px; -fx-pref-width: 140px;"/>

        <Button text="2. Eliminar Índice" onAction="#ejecutarEliminar" GridPane.columnIndex="1" GridPane.rowIndex="0"
                style="-fx-background-color: #a82020; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 14px; -fx-pref-width: 140px;"/>

        <Button text="3. Buscar Dato" onAction="#ejecutarBuscar" GridPane.columnIndex="2" GridPane.rowIndex="0"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 14px; -fx-pref-width: 140px;"/>

        <Button text="4. Mostrar Todo" onAction="#ejecutarMostrar" GridPane.columnIndex="0" GridPane.rowIndex="1"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 14px; -fx-pref-width: 140px;"/>

        <Button text="5. Modificar" onAction="#ejecutarModificar" GridPane.columnIndex="1" GridPane.rowIndex="1"
                style="-fx-background-color: #2a2a32; -fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px; -fx-cursor: hand; -fx-padding: 8px 14px; -fx-pref-width: 140px;"/>
    </GridPane>

    <!-- Área de Resultados Estilizada -->
    <TextArea fx:id="txtResultado" editable="false" prefHeight="160"
              style="-fx-control-inner-background: #18181b; -fx-text-fill: #00ff66; -fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 13px; -fx-background-radius: 6px; -fx-border-color: #3a3a45; -fx-border-radius: 6px;"/>

    <!-- Botón para regresar al menú principal -->
    <Button fx:id="btnRegresar" text="← Regresar al Menú" onAction="#ejecutarRegresar"
            style="-fx-background-color: transparent; -fx-text-fill: #8a8a93; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;"/>
</VBox>
